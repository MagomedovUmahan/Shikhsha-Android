<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/activity_root"
    android:background="@drawable/activity_widget_background"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/activity_rings"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/activity_rings_preview"
            android:contentDescription="@null"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#a8f632"
                    android:ellipsize="end"
                    android:id="@+id/activity_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Шаги —"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/activity_icon_steps"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#00d4ee"
                    android:ellipsize="end"
                    android:id="@+id/activity_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Мин —"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/activity_icon_minutes"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#b54dff"
                    android:ellipsize="end"
                    android:id="@+id/activity_calories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ккал ≈ —"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/activity_icon_calories"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_0"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_1"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_2"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_3"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_4"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_5"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="9sp"
                android:textColor="#bbbbbb"
                android:id="@+id/activity_day_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/activity_week_6"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:src="@drawable/activity_rings_preview"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="8sp"
        android:textColor="#aeaeb5"
        android:ellipsize="end"
        android:id="@+id/activity_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Открой Шихшу"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</LinearLayout>
