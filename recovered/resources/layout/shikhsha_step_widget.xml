<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/shikhsha_widget_root"
    android:background="@drawable/shikhsha_widget_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/shikhsha_widget_eagle"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ff613f"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ШИХША"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.15"/>
        <TextView
            android:textSize="28sp"
            android:textColor="#ff613f"
            android:gravity="center"
            android:id="@+id/shikhsha_widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="↻"
            android:includeFontPadding="false"
            android:contentDescription="Обновить виджет"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="#a1a5af"
        android:id="@+id/shikhsha_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Шаги за день"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#f4f5f7"
            android:ellipsize="end"
            android:id="@+id/shikhsha_widget_steps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="—"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#a1a5af"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="шагов"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="#a1a5af"
        android:ellipsize="end"
        android:id="@+id/shikhsha_widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Личная цель в приложении"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <ProgressBar
        android:id="@+id/shikhsha_widget_progress"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/shikhsha_widget_progress"
        android:progressTint="#ff613f"
        android:progressBackgroundTint="#343944"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ff613f"
        android:ellipsize="end"
        android:id="@+id/shikhsha_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Открой приложение"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#a1a5af"
        android:ellipsize="end"
        android:id="@+id/shikhsha_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Данных датчика пока нет"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</LinearLayout>
