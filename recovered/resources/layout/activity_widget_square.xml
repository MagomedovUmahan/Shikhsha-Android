<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/activity_root"
    android:background="@drawable/activity_widget_background"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/activity_rings"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/activity_rings_preview"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#a8f632"
            android:ellipsize="end"
            android:id="@+id/activity_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Шаги —"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/activity_icon_steps"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#00d4ee"
            android:ellipsize="end"
            android:id="@+id/activity_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мин —"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/activity_icon_minutes"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#b54dff"
            android:ellipsize="end"
            android:id="@+id/activity_calories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ккал ≈ —"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/activity_icon_calories"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"/>
    </LinearLayout>
    <TextView
        android:textSize="8sp"
        android:textColor="#aeaeb5"
        android:ellipsize="end"
        android:id="@+id/activity_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Открой Шихшу"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</LinearLayout>
