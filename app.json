{
  "expo": {
    "name": "Шихша",
    "slug": "shikhsha",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shikhsha.pedometer",
      "infoPlist": {
        "NSMotionUsageDescription": "Шихша использует данные движения и фитнеса для подсчёта шагов и истории прогулок.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "app.shikhsha.pedometer",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090E12"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Шихша использует точную геопозицию для записи маршрута во время прогулки.",
          "locationAlwaysAndWhenInUsePermission": "Шихша записывает выбранную тобой прогулку, даже когда экран заблокирован. Запись прекращается после завершения прогулки.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "scheme": "shikhsha",
    "description": "EAGLE VISION. Кавказская эстетика, шаги и твой личный маршрут.",
    "backgroundColor": "#090E12"
  }
}
